    <Compile Include="..\..\src\DualScreen\Update\UpdateService.cs;..\..\src\DualScreen\Update\Updater.cs;..\..\src\DualScreen\Remote\MqttWsClient.cs;..\..\src\DualScreen\Remote\IceCredentials.cs;..\..\src\DualScreen\Remote\SipLogBridge.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="SIPSorcery" Version="10.0.17" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
