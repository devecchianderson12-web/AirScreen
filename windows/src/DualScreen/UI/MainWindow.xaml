<Window x:Class="DualScreen.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DualScreen" Width="1000" Height="700" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="-1" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Image Source="pack://application:,,,/Assets/logo.png" Width="18" Height="18" Margin="0,0,12,0"/>
                <TextBlock Text="DualScreen" FontSize="12" VerticalAlignment="Center"/>
                <Border x:Name="UpdateBadge" Visibility="Collapsed" Background="{StaticResource AccentBrush}" CornerRadius="8" Padding="8,1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Actualización disponible" FontSize="11" Foreground="Black"/>
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Content="&#xE921;" Style="{StaticResource TitleBarButton}" Click="Minimize_Click" ToolTip="Minimizar"/>
                <Button x:Name="MaxButton" Content="&#xE922;" Style="{StaticResource TitleBarButton}" Click="Maximize_Click" ToolTip="Maximizar"/>
                <Button Content="&#xE8BB;" Style="{StaticResource CloseButton}" Click="Close_Click" ToolTip="Cerrar (DualScreen sigue en el área de notificaciones)"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation -->
            <StackPanel Grid.Column="0" Margin="4,4,4,0">
                <RadioButton x:Name="NavHome" Style="{StaticResource NavItem}" Tag="&#xE80F;" Content="Inicio" IsChecked="True" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavDisplay" Style="{StaticResource NavItem}" Tag="&#xE7F4;" Content="Pantalla" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavConnection" Style="{StaticResource NavItem}" Tag="&#xE71B;" Content="Conexión" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavUpdates" Style="{StaticResource NavItem}" Tag="&#xE895;" Content="Actualizaciones" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Tag="&#xE713;" Content="Configuración" Checked="Nav_Checked"/>
            </StackPanel>

            <!-- Content -->
            <Border Grid.Column="1" Background="#4D1C1C1C" CornerRadius="8,0,0,0" BorderBrush="{StaticResource SubtleStrokeBrush}" BorderThickness="1,1,0,0">
                <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto" Padding="36,28,36,28">
                    <Grid x:Name="Pages" MaxWidth="900" HorizontalAlignment="Stretch">

                        <!-- ===================== HOME ===================== -->
                        <StackPanel x:Name="PageHome">
                            <TextBlock Text="Inicio" Style="{StaticResource TitleText}"/>
                            <Border Style="{StaticResource Card}" Padding="24">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="64" Height="64" Margin="0,0,20,0">
                                        <Ellipse x:Name="StatusHalo" Fill="{StaticResource AccentBrush}" Opacity="0.15"/>
                                        <TextBlock Text="&#xE8EA;" Style="{StaticResource Icon}" FontSize="28" HorizontalAlignment="Center"/>
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{StaticResource TextTertiaryBrush}" Margin="0,0,8,0"/>
                                            <TextBlock x:Name="StatusText" Text="Esperando un teléfono" FontSize="20" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <TextBlock x:Name="DeviceText" Text="Abre DualScreen en tu Android y pulsa Conectar." Style="{StaticResource CaptionText}" FontSize="13" Margin="0,6,0,0"/>
                                        <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
                                    </StackPanel>
                                    <Button x:Name="ConnectButton" Grid.Column="2" Style="{StaticResource BigConnectButton}" Click="ConnectButton_Click" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="ConnectIcon" Text="&#xE71B;" Style="{StaticResource Icon}" Foreground="Black" Margin="0,0,10,0"/>
                                            <TextBlock x:Name="ConnectLabel" Text="Conectar" Foreground="Black" FontWeight="SemiBold" FontSize="16"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <Border x:Name="FirewallCard" Style="{StaticResource Card}" Margin="0,8,0,0" Visibility="Collapsed" BorderBrush="{StaticResource WarningBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE83D;" Style="{StaticResource Icon}" Foreground="{StaticResource WarningBrush}" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                                               Text="El firewall de Windows bloquea las conexiones por Wi-Fi. Permítelas para la menor latencia (la conexión remota sigue funcionando)."/>
                                    <Button Grid.Column="2" Content="Permitir" Style="{StaticResource AccentButton}" Click="AllowFirewall_Click" Margin="12,0,0,0"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="Transmisión" Style="{StaticResource SubtitleText}"/>
                            <UniformGrid Columns="3" x:Name="StatsGrid">
                                <Border Style="{StaticResource Card}" Margin="0,0,4,4"><StackPanel>
                                    <TextBlock Text="Resolución" Style="{StaticResource CaptionText}"/>
                                    <TextBlock x:Name="StatResolution" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
                                <Border Style="{StaticResource Card}" Margin="0,0,4,4"><StackPanel>
                                    <TextBlock Text="Frecuencia" Style="{StaticResource CaptionText}"/>
                                    <TextBlock x:Name="StatRefresh" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,4"><StackPanel>
                                    <TextBlock Text="Calidad" Style="{StaticResource CaptionText}"/>
                                    <TextBlock x:Name="StatQuality" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
                                <Border Style="{StaticResource Card}" Margin="0,0,4,0"><StackPanel>
                                    <TextBlock Text="Latencia estimada" Style="{StaticResource CaptionText}"/>
                                    <TextBlock x:Name="StatLatency" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
                                <Border Style="{StaticResource Card}" Margin="0,0,4,0"><StackPanel>
                                    <TextBlock Text="Velocidad de transmisión" Style="{StaticResource CaptionText}"/>
                                    <TextBlock x:Name="StatBitrate" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
                                <Border Style="{StaticResource Card}" Margin="0"><StackPanel>
                                    <TextBlock Text="Códec / codificador" Style="{StaticResource CaptionText}"/>
                                    <TextBlock x:Name="StatEncoder" Text="—" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
                            </UniformGrid>
                            <TextBlock x:Name="TransportText" Style="{StaticResource CaptionText}" Margin="2,10,0,0"/>
                        </StackPanel>

                        <!-- ===================== DISPLAY ===================== -->
                        <StackPanel x:Name="PageDisplay" Visibility="Collapsed">
                            <TextBlock Text="Pantalla" Style="{StaticResource TitleText}"/>
                            <TextBlock Text="Modo" Style="{StaticResource SubtitleText}" Margin="2,0,0,8"/>
                            <UniformGrid Columns="2">
                                <RadioButton x:Name="ModeExtended" GroupName="mode" Style="{StaticResource OptionCard}" Tag="&#xE7F4;" Checked="Mode_Checked">
                                    <StackPanel>
                                        <TextBlock Text="Pantalla extendida" FontWeight="SemiBold"/>
                                        <TextBlock Text="El teléfono es un monitor adicional real: arrastra ventanas hacia él." Style="{StaticResource CaptionText}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="ModeMirror" GroupName="mode" Style="{StaticResource OptionCard}" Tag="&#xE8C8;" Checked="Mode_Checked">
                                    <StackPanel>
                                        <TextBlock Text="Modo espejo" FontWeight="SemiBold"/>
                                        <TextBlock Text="Replica el monitor principal en el teléfono." Style="{StaticResource CaptionText}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>
                            <Border x:Name="DriverWarning" Style="{StaticResource Card}" Margin="0,8,0,0" Visibility="Collapsed" BorderBrush="{StaticResource WarningBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{StaticResource WarningBrush}" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                                               Text="El modo extendido necesita el controlador de pantalla virtual (requiere permisos de administrador una sola vez)."/>
                                    <Button Grid.Column="2" Content="Instalar controlador" Style="{StaticResource AccentButton}" Click="InstallDriver_Click" Margin="12,0,0,0"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="Imagen" Style="{StaticResource SubtitleText}"/>
                            <Border Style="{StaticResource Card}"><DockPanel>
                                <ComboBox x:Name="ResolutionBox" DockPanel.Dock="Right" SelectionChanged="DisplaySetting_Changed"/>
                                <StackPanel><TextBlock Text="Resolución"/><TextBlock x:Name="ResolutionHint" Text="Solo se muestran las resoluciones que tu teléfono puede decodificar." Style="{StaticResource CaptionText}"/></StackPanel>
                            </DockPanel></Border>
                            <Border Style="{StaticResource Card}"><DockPanel>
                                <ComboBox x:Name="RefreshBox" DockPanel.Dock="Right" SelectionChanged="DisplaySetting_Changed"/>
                                <StackPanel><TextBlock Text="Frecuencia de actualización"/><TextBlock Text="Se reduce automáticamente si la red no puede sostenerla." Style="{StaticResource CaptionText}"/></StackPanel>
                            </DockPanel></Border>
                            <Border Style="{StaticResource Card}"><DockPanel>
                                <ComboBox x:Name="OrientationBox" DockPanel.Dock="Right" SelectionChanged="DisplaySetting_Changed">
                                    <ComboBoxItem Content="Horizontal"/>
                                    <ComboBoxItem Content="Vertical"/>
                                    <ComboBoxItem Content="Horizontal (invertida)"/>
                                    <ComboBoxItem Content="Vertical (invertida)"/>
                                </ComboBox>
                                <TextBlock Text="Orientación" VerticalAlignment="Center"/>
                            </DockPanel></Border>
                            <Border Style="{StaticResource Card}"><DockPanel>
                                <ComboBox x:Name="QualityBox" DockPanel.Dock="Right" SelectionChanged="DisplaySetting_Changed">
                                    <ComboBoxItem Content="Automática (adaptativa)"/>
                                    <ComboBoxItem Content="Máxima"/>
                                    <ComboBoxItem Content="Alta"/>
                                    <ComboBoxItem Content="Equilibrada"/>
                                    <ComboBoxItem Content="Ahorro de datos"/>
                                </ComboBox>
                                <StackPanel><TextBlock Text="Calidad de imagen"/><TextBlock Text="Define el bitrate objetivo; el control adaptativo nunca lo supera." Style="{StaticResource CaptionText}"/></StackPanel>
                            </DockPanel></Border>

                            <TextBlock Text="Rendimiento" Style="{StaticResource SubtitleText}"/>
                            <Border Style="{StaticResource Card}"><DockPanel>
                                <ComboBox x:Name="PerformanceBox" DockPanel.Dock="Right" SelectionChanged="DisplaySetting_Changed">
                                    <ComboBoxItem Content="Latencia mínima"/>
                                    <ComboBoxItem Content="Equilibrado"/>
                                    <ComboBoxItem Content="Calidad"/>
                                </ComboBox>
                                <TextBlock Text="Prioridad" VerticalAlignment="Center"/>
                            </DockPanel></Border>
                            <Border Style="{StaticResource Card}"><DockPanel>
                                <ComboBox x:Name="CodecBox" DockPanel.Dock="Right" SelectionChanged="DisplaySetting_Changed">
                                    <ComboBoxItem Content="Automático"/>
                                    <ComboBoxItem Content="H.264"/>
                                    <ComboBoxItem Content="H.265 / HEVC"/>
                                    <ComboBoxItem Content="AV1"/>
                                </ComboBox>
                                <StackPanel><TextBlock Text="Códec"/><TextBlock x:Name="CodecHint" Style="{StaticResource CaptionText}"/></StackPanel>
                            </DockPanel></Border>
                            <Border Style="{StaticResource Card}"><DockPanel>
                                <TextBlock x:Name="BitrateValue" DockPanel.Dock="Right" Width="90" TextAlignment="Right" VerticalAlignment="Center"/>
                                <Slider x:Name="BitrateSlider" DockPanel.Dock="Right" Width="220" Minimum="0" Maximum="150" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="Bitrate_Changed"/>
                                <StackPanel><TextBlock Text="Bitrate máximo"/><TextBlock Text="0 = automático según resolución y frecuencia." Style="{StaticResource CaptionText}"/></StackPanel>
                            </DockPanel></Border>
                        </StackPanel>

                        <!-- ===================== CONNECTION ===================== -->
                        <StackPanel x:Name="PageConnection" Visibility="Collapsed">
                            <TextBlock Text="Conexión" Style="{StaticResource TitleText}"/>
                            <Border Style="{StaticResource Card}" Padding="24">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Border Background="White" CornerRadius="8" Padding="10" Width="196" Height="196" Margin="0,0,28,0">
                                        <Image x:Name="QrImage" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Código de emparejamiento" Style="{StaticResource CaptionText}"/>
                                        <TextBlock x:Name="PairCode" Text="— — —" FontFamily="{StaticResource DisplayFont}" FontSize="44" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                        <TextBlock x:Name="PairExpiry" Style="{StaticResource CaptionText}"/>
                                        <TextBlock Text="Escanea el QR desde la app de Android (recomendado: verifica la identidad del PC) o escribe el código." Style="{StaticResource CaptionText}" Margin="0,12,0,12"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource AccentButton}" Click="NewCode_Click">
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" Foreground="Black" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="Generar nuevo código" Foreground="Black"/></StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Text="Estado" Style="{StaticResource SubtitleText}"/>
                            <Border Style="{StaticResource Card}"><DockPanel>
                                <TextBlock x:Name="LanStatus" DockPanel.Dock="Right" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE701;" Style="{StaticResource Icon}" Margin="0,0,12,0"/><TextBlock Text="Red local" VerticalAlignment="Center"/></StackPanel>
                            </DockPanel></Border>
                            <Border Style="{StaticResource Card}"><DockPanel>
                                <TextBlock x:Name="LanAddresses" DockPanel.Dock="Right" Style="{StaticResource CaptionText}" VerticalAlignment="Center" TextAlignment="Right"/>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE968;" Style="{StaticResource Icon}" Margin="0,0,12,0"/><TextBlock Text="Dirección y puerto" VerticalAlignment="Center"/></StackPanel>
                            </DockPanel></Border>
                            <Border Style="{StaticResource Card}"><DockPanel>
                                <TextBlock x:Name="RemoteStatus" DockPanel.Dock="Right" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE774;" Style="{StaticResource Icon}" Margin="0,0,12,0"/><TextBlock Text="Conexión remota (WebRTC)" VerticalAlignment="Center"/></StackPanel>
                            </DockPanel></Border>
                            <Border Style="{StaticResource Card}"><DockPanel>
                                <TextBlock x:Name="Fingerprint" DockPanel.Dock="Right" Style="{StaticResource CaptionText}" FontFamily="Consolas" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" Margin="0,0,12,0"/><TextBlock Text="Huella del PC" VerticalAlignment="Center"/></StackPanel>
                            </DockPanel></Border>

                            <TextBlock Text="Dispositivos emparejados" Style="{StaticResource SubtitleText}"/>
                            <StackPanel x:Name="DeviceList"/>
                            <TextBlock x:Name="NoDevices" Text="Todavía no hay dispositivos emparejados." Style="{StaticResource CaptionText}" Margin="2,4,0,0"/>
                        </StackPanel>

                        <!-- ===================== UPDATES ===================== -->
                        <StackPanel x:Name="PageUpdates" Visibility="Collapsed">
                            <TextBlock Text="Actualizaciones" Style="{StaticResource TitleText}"/>
                            <Border Style="{StaticResource Card}" Padding="24">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" FontSize="32" Margin="0,0,20,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="UpdateTitle" Text="DualScreen está actualizado" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="UpdateVersions" Style="{StaticResource CaptionText}" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="UpdateStatus" Style="{StaticResource CaptionText}" Margin="0,4,0,0"/>
                                        <ProgressBar x:Name="UpdateProgress" Height="3" Margin="0,10,0,0" Maximum="1" Visibility="Collapsed" Foreground="{StaticResource AccentBrush}" Background="#22FFFFFF" BorderThickness="0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="PostponeButton" Content="Posponer" Margin="0,0,8,0" Click="Postpone_Click" Visibility="Collapsed"/>
                                        <Button x:Name="UpdateNowButton" Content="Actualizar ahora" Style="{StaticResource AccentButton}" Margin="0,0,8,0" Click="UpdateNow_Click" Visibility="Collapsed"/>
                                        <Button x:Name="CheckButton" Content="Buscar actualizaciones" Click="CheckUpdates_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <TextBlock Text="Novedades" Style="{StaticResource SubtitleText}"/>
                            <Border Style="{StaticResource Card}">
                                <TextBlock x:Name="ReleaseNotes" Text="—" Style="{StaticResource CaptionText}"/>
                            </Border>
                            <Border Style="{StaticResource Card}"><DockPanel>
                                <CheckBox x:Name="AutoUpdateToggle" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" Click="AutoUpdate_Click"/>
                                <StackPanel><TextBlock Text="Buscar actualizaciones automáticamente"/><TextBlock x:Name="UpdateSourceText" Style="{StaticResource CaptionText}"/></StackPanel>
                            </DockPanel></Border>
                        </StackPanel>

                        <!-- ===================== SETTINGS ===================== -->
                        <StackPanel x:Name="PageSettings" Visibility="Collapsed">
                            <TextBlock Text="Configuración" Style="{StaticResource TitleText}"/>
                            <TextBlock Text="General" Style="{StaticResource SubtitleText}" Margin="2,0,0,8"/>
                            <Border Style="{StaticResource Card}"><DockPanel>
                                <CheckBox x:Name="StartupToggle" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" Click="Startup_Click"/>
                                <StackPanel><TextBlock Text="Iniciar con Windows"/><TextBlock Text="Arranca en segundo plano, solo en el área de notificaciones." Style="{StaticResource CaptionText}"/></StackPanel>
                            </DockPanel></Border>
                            <Border Style="{StaticResource Card}"><DockPanel>
                                <CheckBox x:Name="NotifyToggle" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" Click="Notify_Click"/>
                                <TextBlock Text="Mostrar notificaciones" VerticalAlignment="Center"/>
                            </DockPanel></Border>
                            <Border Style="{StaticResource Card}"><DockPanel>
                                <TextBox x:Name="HostNameBox" DockPanel.Dock="Right" Width="240" LostFocus="HostName_LostFocus"/>
                                <StackPanel><TextBlock Text="Nombre de este PC"/><TextBlock Text="Así aparece en el teléfono." Style="{StaticResource CaptionText}"/></StackPanel>
                            </DockPanel></Border>

                            <TextBlock Text="Red local" Style="{StaticResource SubtitleText}"/>
                            <Border Style="{StaticResource Card}"><DockPanel>
                                <CheckBox x:Name="LanToggle" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" Click="Network_Changed"/>
                                <TextBlock Text="Aceptar conexiones por Wi-Fi / LAN" VerticalAlignment="Center"/>
                            </DockPanel></Border>
                            <Border Style="{StaticResource Card}"><DockPanel>
                                <TextBox x:Name="PortBox" DockPanel.Dock="Right" Width="120" LostFocus="Network_Changed"/>
                                <StackPanel><TextBlock Text="Puerto TCP"/><TextBlock Text="El descubrimiento usa UDP 47801." Style="{StaticResource CaptionText}"/></StackPanel>
                            </DockPanel></Border>

                            <TextBlock Text="Conexión remota" Style="{StaticResource SubtitleText}"/>
                            <Border Style="{StaticResource Card}"><DockPanel>
                                <CheckBox x:Name="RemoteToggle" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" Click="Network_Changed"/>
                                <StackPanel><TextBlock Text="Permitir conexiones desde otras redes"/><TextBlock Text="Necesita un servidor de señalización (ver docs/REMOTE.md). Conexión P2P directa con TURN de respaldo." Style="{StaticResource CaptionText}"/></StackPanel>
                            </DockPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel>
                                <TextBlock Text="Servidor de señalización (wss://…)"/>
                                <TextBox x:Name="SignalingBox" Margin="0,8,0,0" LostFocus="Network_Changed"/>
                                <TextBlock Text="Servidores STUN (separados por coma)" Margin="0,12,0,0"/>
                                <TextBox x:Name="StunBox" Margin="0,8,0,0" LostFocus="Network_Changed"/>
                                <TextBlock Text="Servidor TURN propio (opcional, turn:host:3478)" Margin="0,12,0,0"/>
                                <TextBox x:Name="TurnBox" Margin="0,8,0,0" LostFocus="Network_Changed"/>
                                <UniformGrid Columns="2" Margin="0,8,0,0">
                                    <TextBox x:Name="TurnUserBox" Margin="0,0,4,0" LostFocus="Network_Changed" ToolTip="Usuario TURN"/>
                                    <PasswordBox x:Name="TurnPassBox" Margin="4,0,0,0" LostFocus="Network_Changed" ToolTip="Contraseña TURN (se guarda cifrada con DPAPI)"/>
                                </UniformGrid>
                            </StackPanel></Border>

                            <TextBlock Text="Controlador de pantalla virtual" Style="{StaticResource SubtitleText}"/>
                            <Border Style="{StaticResource Card}"><DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button x:Name="DriverInstallButton" Content="Instalar" Style="{StaticResource AccentButton}" Click="InstallDriver_Click" Margin="0,0,8,0"/>
                                    <Button x:Name="DriverUninstallButton" Content="Desinstalar" Click="UninstallDriver_Click"/>
                                </StackPanel>
                                <StackPanel><TextBlock x:Name="DriverStatus" Text="Estado del controlador"/><TextBlock x:Name="DriverDetail" Style="{StaticResource CaptionText}"/></StackPanel>
                            </DockPanel></Border>

                            <TextBlock Text="Diagnóstico" Style="{StaticResource SubtitleText}"/>
                            <Border Style="{StaticResource Card}"><DockPanel>
                                <Button DockPanel.Dock="Right" Content="Abrir carpeta" Click="OpenData_Click"/>
                                <StackPanel><TextBlock Text="Datos y registros"/><TextBlock x:Name="DataPath" Style="{StaticResource CaptionText}"/></StackPanel>
                            </DockPanel></Border>
                            <Border Style="{StaticResource Card}">
                                <TextBlock x:Name="AboutText" Style="{StaticResource CaptionText}"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
