<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DualScreen</RootNamespace>
    <AssemblyName>DualScreen</AssemblyName>
    <ApplicationIcon>Assets\DualScreen.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.2.4</Version>
    <Product>DualScreen</Product>
    <Company>DualScreen</Company>
    <Copyright>Copyright (c) DualScreen contributors</Copyright>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <StartupObject>DualScreen.Program</StartupObject>
    <RepoRoot>$(MSBuildThisFileDirectory)..\..\..\</RepoRoot>
    <!-- CI passes the signed driver package directory; local builds work without it (mirror mode only). -->
    <DriverPackageDir Condition="'$(DriverPackageDir)' == ''">$(RepoRoot)build\driver\</DriverPackageDir>
  </PropertyGroup>
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
    <Resource Include="Assets\DualScreen.ico" />
    <Resource Include="Assets\logo.png" />
    <EmbeddedResource Include="$(RepoRoot)dualscreen.repo.json" LogicalName="DualScreen.repo.json" />
    <EmbeddedResource Include="$(RepoRoot)config\update-public-key.pem" LogicalName="DualScreen.update-public-key.pem"
                      Condition="Exists('$(RepoRoot)config\update-public-key.pem')" />
    <EmbeddedResource Include="$(DriverPackageDir)*.*" LogicalName="driver/%(Filename)%(Extension)"
                      Condition="Exists('$(DriverPackageDir)DualScreenIdd.inf')" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />
    <PackageReference Include="SIPSorcery" Version="10.0.17" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
  </ItemGroup>
</Project>
