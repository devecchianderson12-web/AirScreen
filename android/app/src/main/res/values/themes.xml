<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DualScreen" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text2</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="Theme.DualScreen.Fullscreen" parent="Theme.DualScreen">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
    <style name="Card">
        <item name="android:background">@drawable/card</item>
        <item name="android:padding">18dp</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>
    <style name="Label">
        <item name="android:textColor">@color/text2</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="Value">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Button.Accent" parent="android:Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/btn_accent</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">54dp</item>
    </style>
    <style name="Button.Tonal" parent="android:Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/btn_tonal</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">48dp</item>
    </style>
</resources>
